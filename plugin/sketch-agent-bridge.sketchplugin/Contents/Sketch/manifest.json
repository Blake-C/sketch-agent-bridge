{
	"name": "Agent Bridge",
	"identifier": "com.digitalblake.sketch-agent-bridge",
	"description": "Lets AI agents read and edit the open Sketch document through a local MCP server.",
	"author": "Blake Cerecero",
	"version": "0.1.0",
	"compatibleVersion": 3,
	"bundleVersion": 1,
	"disableCocoaScriptPreprocessor": true,
	"commands": [
		{
			"name": "Bridge",
			"identifier": "bridge",
			"script": "bridge.js",
			"handler": "onBridge"
		},
		{
			"name": "Send Selection to Agent",
			"identifier": "sendSelection",
			"script": "send-selection.js",
			"handler": "onSendSelection",
			"shortcut": "ctrl shift a"
		}
	],
	"menu": {
		"title": "Agent Bridge",
		"items": ["sendSelection"]
	}
}
